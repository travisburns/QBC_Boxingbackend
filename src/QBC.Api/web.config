<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for the ASP.NET Core app (SmarterASP.NET / IIS).

  `dotnet publish` rewrites the <aspNetCore> element's processPath, arguments and
  hostingModel for the actual build, so the values below are just placeholders.
  The part that matters and is preserved: removing the WebDAV module and the
  built-in OPTIONSVerbHandler. On IIS those intercept CORS preflight (OPTIONS)
  requests before ASP.NET Core's CORS middleware can answer them, which the
  browser reports as "CORS Failed". Removing them lets OPTIONS reach the app so
  the configured CORS policy can respond.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="OPTIONSVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\QBC.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
